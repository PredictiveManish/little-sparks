# Smartivity Little Sparks - Environment Variables
# Copy this file to .env and fill in the values

# JWT signing key - generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=your-secret-key-here

# Fernet encryption key for Slack tokens - generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-fernet-encryption-key-here

# Slack App configuration
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_TEAM_ID=your-slack-workspace-team-id
SLACK_REDIRECT_URI=https://your-backend-url.onrender.com/api/slack/oauth/callback

# Server
DATABASE_URL=sqlite:///./smartivity.db

# CORS - comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,https://your-frontend-url.netlify.app

# Frontend URL (for Slack callback redirects)
FRONTEND_URL=http://localhost:3000
