# ── Supabase Postgres ──────────────────────────────────────────────
# Use the POOLED connection string (port 6543, pgbouncer transaction mode)
# NOT the direct connection (port 5432)
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# ── Serverless flag ────────────────────────────────────────────────
SERVERLESS=true

# DOMAIN Link
SITE_URL=DOMAIN_URL

# ── Cron ───────────────────────────────────────────────────────────
CRON_SECRET=generate-a-random-secret-here

# ── Auth ───────────────────────────────────────────────────────────
SECRET_KEY=generate-with-python-secrets-token_urlsafe-48
ENCRYPTION_KEY=generate-with-Fernet-generate_key
ADMIN_EMAIL=
ADMIN_PASSWORD=
# ── Slack ──────────────────────────────────────────────────────────
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_TEAM_ID=
SLACK_SIGNING_SECRET=
SLACK_BOT_SCOPES=chat:write,channels:manage,groups:write,users:read,users:read.email,commands

# ── Domain-dependent URLs ─────────────────────────────────────────
# ⚠️ DOMAIN: Update these to your Netlify domain when ready
SLACK_REDIRECT_URI=https://YOUR-APP-NETLIFY-APP.netlify.app/api/slack/oauth/callback
SLACK_BOT_REDIRECT_URI=https://YOUR-APP-NETLIFY-APP.netlify.app/api/slack/install/callback
FRONTEND_URL=https://YOUR-APP-NETLIFY-APP.netlify.app
ALLOWED_ORIGINS=https://YOUR-APP-NETLIFY-APP.netlify.app

# ── Reminder schedule (optional, defaults shown) ───────────────────
REMINDER_TIMEZONE=Asia/Kolkata
DAILY_REMINDER_HOUR=12