    if config:
        config.bot_token = encrypted_bot
        config.signing_secret = encrypted_secret
        config.encrypted = True
        config.slack_team_id = data.slack_team_id
        db.commit()
        db.refresh(config)
        return SlackConfigResponse.model_validate(config)
